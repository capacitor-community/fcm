<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          xmlns:tools="http://schemas.android.com/tools">
    <application>
        <!--
            Drop the @capacitor/push-notifications default MessagingService
            from the merged manifest. FCMMessagingService extends it and
            replaces it. Android FCM only routes MESSAGING_EVENT to a single
            FirebaseMessagingService, so we cannot simply add ours alongside.

            If @capacitor/push-notifications is not installed in the consuming
            app this directive is a harmless no-op.

            Maintenance: if @capacitor/push-notifications ever renames or
            relocates MessagingService, this directive silently fails and both
            services would register, with Android picking one
            non-deterministically. The MessagingServiceContractTest unit test
            in this plugin fails CI if the parent class signature changes —
            keep it green when bumping the push-notifications version.
        -->
        <service
            android:name="com.capacitorjs.plugins.pushnotifications.MessagingService"
            tools:node="remove" />

        <service
            android:name="com.getcapacitor.community.fcm.FCMMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
    </application>
</manifest>
